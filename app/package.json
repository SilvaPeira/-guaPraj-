{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrar": "tsx --env-file=.env.local scripts/migrar.ts",
    "db:gerar": "drizzle-kit generate",
    "test:assinatura": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/testar-assinatura.ts",
    "test:pagamento": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/testar-pagamento.ts",
    "test:senha": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/testar-senha.ts",
    "test:planos-app": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/testar-planos-app.ts",
    "test:retornavel": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/testar-retornavel.ts",
    "test:e2e": "next build && playwright test",
    "test:e2e:rapido": "playwright test",
    "test:unit": "npm run -s test:assinatura && npm run -s test:pagamento && npm run -s test:senha && npm run -s test:planos-app && npm run -s test:retornavel && npm run -s test:avisos-conta && npm run -s test:gerador-beneficio",
    "test:avisos-conta": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/testar-avisos-conta.ts",
    "test:gerador-beneficio": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/testar-gerador-beneficio.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.16",
    "leaflet": "^1.9.4",
    "next": "16.4.5",
    "postgres": "^4.1.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
