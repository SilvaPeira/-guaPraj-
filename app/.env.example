# Copie para .env.local (local) ou cadastre na Vercel (produção).

# Postgres de produção (Neon). Vazio = banco embutido local (PGlite).
DATABASE_URL=

# Segredo da sessão: texto aleatório longo. Obrigatório em produção.
SESSION_SECRET=

# Celulares de administradores, com DDD, separados por vírgula.
ADMIN_TELEFONES=

# Envio de WhatsApp (etapa 7). Vazio = só escreve no console (desenvolvimento).
WHATSAPP_PROVEDOR=

# "1" mostra o código de login na tela também em produção. Use só em teste fechado!
OTP_MODO_TESTE=

# Endereço público do app (usado nos links das mensagens de WhatsApp).
APP_URL=

# Segredo do lembrete diário (Vercel Cron envia "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=

# Pagamento online (etapa 6) — Mercado Pago, modelo marketplace (cada loja conecta a própria conta).
# Crie a aplicação em https://www.mercadopago.com.br/developers/panel/app (produto "Checkout Pro",
# modelo de integração "Marketplace") e cadastre a URL de redirecionamento:
#   https://SEU-DOMINIO/api/mercadopago/retorno
# Vazio em desenvolvimento = modo de teste (tela que simula Pix/cartão). Vazio em produção = só "pagar na entrega".
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Assinatura secreta dos avisos (Webhooks → "Assinatura secreta" no painel da aplicação). Opcional, recomendado.
MP_WEBHOOK_SECRET=
# Taxa do ÁguaPrajá por venda paga pelo app, em % (split automático). Vazio ou 0 = sem taxa.
TAXA_PLATAFORMA_PERCENTUAL=

# Notificações no celular/computador (Web Push), grátis e sem provedor.
# Gerar uma vez: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato exigido pelo protocolo (mailto: ou https://). Padrão: APP_URL.
VAPID_CONTATO=
