# Copie para .env.local (local) ou cadastre na Vercel (produção).

# Postgres de produção (Neon). Vazio = banco embutido local (PGlite).
DATABASE_URL=

# Segredo da sessão: texto aleatório longo. Obrigatório em produção.
SESSION_SECRET=

# Celulares de administradores, com DDD, separados por vírgula.
ADMIN_TELEFONES=

# Envio de WhatsApp (etapa 7). Vazio = só escreve no console (desenvolvimento).
WHATSAPP_PROVEDOR=

# "1" mostra o código de login na tela também em produção. Use só em teste fechado!
OTP_MODO_TESTE=
