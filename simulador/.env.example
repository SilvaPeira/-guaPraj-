# Copie para .env.local (local) ou cadastre na Vercel (produção).

# URL do Apps Script da planilha (termina em /exec) — ver planilha/apps-script.gs
PLANILHA_WEBHOOK_URL=
# Mesma senha definida em SEGREDO no Apps Script
PLANILHA_SEGREDO=

# WhatsApp do ÁguaPrajá para contato: só dígitos, 55 + DDD + número (ex.: 5594991234567)
NEXT_PUBLIC_WHATSAPP_CONTATO=
# Endereço público da página (usado no botão "indicar para um vizinho")
NEXT_PUBLIC_URL_PUBLICA=
